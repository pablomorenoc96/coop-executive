# ==============================================================================
# CoopExecutive — Variables de Entorno y Configuración Multimodelo
# ==============================================================================

# Modo de enrutamiento: 'auto', 'openrouter', 'openai', 'anthropic', 'gemini', 'groq', 'mistral', 'deepseek', 'local', 'custom'
PROVIDER=auto

# ------------------------------------------------------------------------------
# 1. RUTA GRATUITA: OpenRouter (Costo $0.00 en la nube)
# ------------------------------------------------------------------------------
# Clave 100% gratuita en https://openrouter.ai/keys (no requiere tarjeta)
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelos recomendados gratuitos ($0.00):
#   minimax/minimax-m3:free
#   nvidia/nemotron-3-super-120b-a12b:free
DEFAULT_MODEL=minimax/minimax-m3:free
DEEP_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ROUTING_MODEL=minimax/minimax-m3:free

# ------------------------------------------------------------------------------
# 2. RUTA LOCAL PRIVADA: Ollama (100% Gratis, Desconectado y Privado)
# ------------------------------------------------------------------------------
# Activa esta opción si ejecutas modelos locales en tu propia máquina (ej. Ollama)
LOCAL_MODELS_ENABLED=false
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODELS=llama3.1:8b,qwen2.5:3b
LOCAL_TIMEOUT_S=300

# ------------------------------------------------------------------------------
# 3. RUTA COMERCIAL / APIS DE PAGO (OPCIONAL)
# ------------------------------------------------------------------------------
# Si tu organización cuenta con cuentas comerciales o créditos institucionales,
# puedes configurar directamente las claves correspondientes. El sistema detectará
# automáticamente el proveedor según el modelo elegido o la clave activa.

# OpenAI (gpt-4o, gpt-4o-mini, o1, o3-mini)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (claude-3-7-sonnet, claude-3-5-sonnet, claude-3-5-haiku)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini (gemini-2.0-flash, gemini-1.5-pro)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Groq (Inferencia ultra rápida para llama-3.3-70b)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mistral AI (mistral-large, mistral-small, codestral)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# DeepSeek (deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Gateway Personalizado / Compatible con OpenAI (Azure OpenAI, vLLM, LiteLLM)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# ------------------------------------------------------------------------------
# Perfil Institucional, Memoria y Zona Horaria
# ------------------------------------------------------------------------------
COMPANY_PROFILE_PATH=../../company/profile.yaml
EPISODIC_DB_PATH=./coop_memory.db
USER_TIMEZONE=America/Mexico_City
LOG_LEVEL=INFO
