# ==============================================================================
# CoopExecutive: configuración de modelos y rutas
# ==============================================================================
# Copie este archivo como `.env` en una de estas carpetas (el último que exista gana):
#   1. la carpeta de usuario: %APPDATA%\CoopExecutive (Windows) o ~/.config/coopexecutive
#   2. la raíz del repositorio, si trabaja desde un checkout
#   3. la carpeta desde la que ejecuta `coopexecutive`
# `coopexecutive info` muestra qué archivos se cargaron.
# Las variables del sistema siempre tienen prioridad sobre el archivo.
#
# Nombres de modelo vigentes al 29/09/2026. Cambian seguido: cualquier modelo
# compatible sirve. `coopexecutive modelos --herramientas` lista los gratuitos.

# auto | openrouter | openai | anthropic | gemini | groq | mistral | deepseek | local | custom
PROVIDER=auto

# ------------------------------------------------------------------------------
# 1. Gratis en la nube: OpenRouter
# ------------------------------------------------------------------------------
# Clave sin costo en https://openrouter.ai/keys. Los modelos `:free` tienen
# límites de uso diario y el proveedor puede usar los datos para entrenar.
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Otros gratuitos: google/gemma-4-26b-a4b-it:free, nvidia/nemotron-3-ultra-550b-a55b:free,
# qwen/qwen3.8-27b:free
DEFAULT_MODEL=google/gemma-4-31b-it:free
DEEP_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ROUTING_MODEL=google/gemma-4-26b-a4b-it:free

# ------------------------------------------------------------------------------
# 2. Gratis y privado: Ollama en su equipo
# ------------------------------------------------------------------------------
# Instale Ollama y descargue el modelo (`ollama pull granite4.1:8b`). Nada sale del equipo.
# LOCAL_MODELS: el primero es el principal y los demás, respaldos en orden.
# Con poca memoria: granite4.1:3b. Con GPU de 24 GB o más: qwen3.8:27b, nemotron3:33b.
LOCAL_MODELS_ENABLED=false
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODELS=granite4.1:8b,qwen3.8:27b
LOCAL_TIMEOUT_S=300

# ------------------------------------------------------------------------------
# 3. APIs de pago (opcional)
# ------------------------------------------------------------------------------
# Con PROVIDER=auto se usa la primera clave presente. Ajuste DEFAULT_MODEL al
# modelo del proveedor elegido.

# OpenAI: gpt-6.1-sol, gpt-6-astra, gpt-6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-4-5
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini: gemini-3.8-flash, gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Groq: llama-3.3-70b-versatile, openai/gpt-oss-120b, openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Mistral: mistral-medium-3-5-26-04, mistral-small-4-0-26-03
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# DeepSeek: deepseek-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Cualquier endpoint compatible con OpenAI (Azure OpenAI, vLLM, LiteLLM, LM Studio)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# ------------------------------------------------------------------------------
# Red
# ------------------------------------------------------------------------------
REQUEST_TIMEOUT_S=180
# Reintentos ante 429, 5xx o caída de conexión antes de pasar al modelo de respaldo (0 a 6)
MAX_REINTENTOS=3

# ------------------------------------------------------------------------------
# Perfil, memoria y registro
# ------------------------------------------------------------------------------
# Sin estas variables, el perfil y la base se buscan en el espacio activo
# (creado con `coopexecutive iniciar`) o, si no hay, en la ubicación por omisión.
# COMPANY_PROFILE_PATH=
# EPISODIC_DB_PATH=
# COOPEXECUTIVE_WORKSPACE=
USER_TIMEZONE=America/Mexico_City
# DEBUG | INFO | WARNING | ERROR. Los mensajes van a stderr.
LOG_LEVEL=WARNING
